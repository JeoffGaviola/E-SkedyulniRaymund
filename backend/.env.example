# Copy this file to .env and fill in your own Supabase project values.
# Never commit real credentials or share SUPABASE_SECRET_KEY.

DATABASE_URL=postgresql+psycopg://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<SERVER_ONLY_SUPABASE_SECRET_KEY>

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>
ADMIN_FULL_NAME=Platform Admin

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_TABLES=false
